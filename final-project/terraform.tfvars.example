aws_region          = "us-east-1"
name_prefix         = "final-project"
s3_bucket_name      = "your-terraform-state-bucket-name"
dynamodb_table_name = "terraform-state-lock"

vpc_cidr = "10.0.0.0/16"

public_subnet_cidrs = [
  "10.0.1.0/24",
  "10.0.2.0/24"
]

private_subnet_cidrs = [
  "10.0.10.0/24",
  "10.0.20.0/24"
]

# EKS Configuration
cluster_name        = "final-project-cluster"
kubernetes_version  = "1.28"
node_min_size       = 1
node_max_size       = 3
node_desired_size   = 2
instance_types      = ["t3.medium"]
capacity_type       = "ON_DEMAND"

# ECR Configuration
ecr_repository_name = "django-app"

# RDS Configuration
use_aurora          = false
rds_engine          = "postgres"
rds_engine_version  = "15.4"
rds_instance_class  = "db.t3.medium"
rds_database_name   = "mydb"
rds_master_username = "admin"
rds_master_password = "ChangeMe123!"  # Use secrets manager in production
rds_allocated_storage = 20
rds_multi_az        = false
rds_publicly_accessible = false
rds_storage_encrypted = true
rds_backup_retention_period = 7
rds_skip_final_snapshot = true

# Jenkins Configuration
jenkins_namespace     = "jenkins"
jenkins_release_name  = "jenkins"
jenkins_chart_version = "5.1.7"

# Argo CD Configuration
argocd_namespace     = "argocd"
argocd_release_name  = "argocd"
argocd_chart_version = "7.2.0"
git_repository_url   = "https://github.com/your-username/your-repo.git"
git_repository_path  = "charts/django-app"
target_revision      = "main"
destination_namespace = "default"

# Monitoring Configuration
monitoring_namespace    = "monitoring"
prometheus_chart_version = "55.0.0"
grafana_chart_version  = "7.0.0"

tags = {
  Project     = "final-project"
  Environment = "production"
  ManagedBy   = "terraform"
}

